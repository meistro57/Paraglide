{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paraglide",
  "version": "0.1.0",
  "identifier": "app.paraglide.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../app/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paraglide",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
